{
  "id": "vue-web-admin",
  "name": "Vue Web Admin",
  "description": "后台管理模板，基于 Vue 3 + Vite + Naive UI，默认单页仪表盘可运行，额外列表、订单和设置页作为可选扩展样板保留。",
  "packageManager": "pnpm",
  "tags": ["vue", "vite", "admin", "dashboard", "table", "naive-ui", "pinia", "typescript"],
  "entryFiles": [
    "src/router/routeManifest.json",
    "src/layouts/MainLayout.vue",
    "src/views/DashboardView.vue",
    "src/data/adminData.ts",
    "src/components/ProTable.vue",
    "src/services/api.ts",
    "src/stores/user.ts",
    "src/stores/app.ts"
  ],
  "optionalFiles": [
    "src/pages/UsersPage.vue",
    "src/pages/OrdersPage.vue",
    "src/pages/SettingsPage.vue",
    "src/pages/LoginPage.vue",
    "src/components/SearchBar.vue",
    "src/components/FormModal.vue"
  ]
}
