{
  "templateId": "vue-web-admin",
  "description": "后台管理模板，基于 Vue 3 + Vite + shadcn-vue + Inspira UI + TresJS，包含指标、筛选、表格、弹窗和设置区",
  "slots": [
    {
      "id": "dashboard_content",
      "file": "src/views/DashboardView.vue",
      "description": "工作台/仪表盘主体内容，包含指标卡片、趋势图、活动列表和表格",
      "required": true,
      "type": "view",
      "category": "page",
      "example": "<template>\n  <div class=\"grid grid-cols-4 gap-4\">\n    <Card v-for=\"item in metrics\" :key=\"item.label\">\n      <CardHeader>\n        <CardTitle>{{ item.label }}</CardTitle>\n      </CardHeader>\n      <CardContent>\n        <div class=\"text-2xl font-bold\">{{ item.value }}</div>\n      </CardContent>\n    </Card>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { metrics } from '@/data/adminData'\n</script>",
      "dependencies": [
        "src/data/adminData.ts",
        "src/components/ProTable.vue"
      ],
      "styleVariables": [
        "--color-primary",
        "--color-success",
        "--color-warning",
        "--color-danger",
        "--panel-bg",
        "--panel-radius"
      ],
      "outputFormat": "完整的 Vue SFC，使用 shadcn-vue 组件",
      "aiHints": {
        "pattern": "指标卡片 + 趋势图 + 活动列表 + 表格",
        "components": [
          "Card",
          "CardHeader",
          "CardTitle",
          "CardContent",
          "Badge"
        ],
        "hooks": [
          "useRouter",
          "useAppStore"
        ]
      }
    },
