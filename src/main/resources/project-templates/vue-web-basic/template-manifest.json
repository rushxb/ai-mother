{
  "templateId": "vue-web-basic",
  "description": "通用 Vue 3 + Vite + shadcn-vue + Inspira UI + TresJS Web 应用模板，适合个人创意项目、炫酷大胆风格、3D 空间叙事",
  "slots": [
    {
      "id": "home_content",
      "file": "src/views/HomeView.vue",
      "description": "首页主体内容区域，包含 Hero 区、3D 场景、模块展示、流程和联系区",
      "required": true,
      "type": "view",
      "category": "page",
      "example": "<template>\n  <section id=\"hero\" class=\"hero\">\n    <div class=\"hero-copy\">\n      <span class=\"eyebrow\">{{ hero.eyebrow }}</span>\n      <h1>{{ hero.title }}</h1>\n      <p>{{ hero.description }}</p>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nimport { hero } from '@/data/siteData'\n</script>",
      "dependencies": ["src/data/siteData.ts", "src/components/inspira/GradientText.vue"],
      "styleVariables": ["--color-primary", "--color-secondary", "--color-bg", "--color-text", "--spacing-md", "--radius-md"],
      "outputFormat": "完整的 Vue SFC，包含 <template>、<script setup lang=\"ts\">、<style scoped>",
      "aiHints": {
        "pattern": "Hero + 3D 场景 + 内容卡片 + 流程 + 联系区",
        "components": ["GradientText", "AnimateOnScroll", "ParticleField", "BasicScene"],
        "hooks": ["useRouter", "useAppStore"]
      }
    },
