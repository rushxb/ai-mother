{
  "templateId": "vue-web-mobile",
  "description": "移动端 H5，基于 Vue 3 + Vite + Vant 4 + vaul-vue + motion-v + TresJS + Lenis，适合电商、内容、活动等移动端场景",
  "slots": [
    {
      "id": "home_content",
      "file": "src/views/HomeView.vue",
      "description": "首页主体内容区域，包含轮播、商品列表、底部导航等移动端组件",
      "required": true,
      "type": "view",
      "category": "page",
      "example": "<template>\n  <MobileHomePage />\n</template>\n\n<script setup lang=\"ts\">\nimport MobileHomePage from '@/pages/MobileHomePage.vue'\n</script>",
      "dependencies": [
        "src/data/mobileData.ts"
      ],
      "styleVariables": [
        "--color-primary",
        "--color-bg",
        "--tabbar-height",
        "--safe-area-bottom"
      ],
      "outputFormat": "完整的 Vue SFC，使用 Vant 4 组件",
      "aiHints": {
        "pattern": "轮播 + 分类 + 商品列表 + 底部导航",
        "components": [
          "van-swipe",
          "van-grid",
          "van-card",
          "van-tabbar"
        ],
        "hooks": [
          "useRouter",
          "useCartStore"
        ]
      }
    },
    {
      "id": "theme_tokens",
      "file": "src/styles/mobile.css",
      "description": "主题色和基础样式变量，定义移动端的全局 CSS 变量",
      "required": false,
      "type": "style",
      "category": "theme",
      "example": ":root {\n  --color-primary: #1989fa;\n  --color-bg: #f7f8fa;\n  --tabbar-height: 50px;\n  --safe-area-bottom: env(safe-area-inset-bottom);\n}",
      "dependencies": null,
      "styleVariables": [
        "--color-primary",
        "--color-bg",
        "--tabbar-height",
        "--safe-area-bottom"
      ],
      "outputFormat": "CSS 变量定义，使用 :root 选择器"
    },
    {
      "id": "mock_data",
      "file": "src/data/mobileData.ts",
      "description": "页面真实消费的共享运行时数据，包含主题、导航、活动、列表、订单与个人中心内容",
      "required": true,
      "type": "data",
      "category": "data",
      "example": "export const banners = [{ title: '本周精选', desc: '热门内容' }]\nexport const productSections = [{ title: '推荐', items: [] }]",
      "dependencies": null,
      "styleVariables": null,
      "outputFormat": "TypeScript 常量导出",
      "aiHints": {
        "pattern": "数据结构定义 + 常量导出",
        "types": ["themeVars", "tabs", "banners", "quickEntries", "productSections", "orders"]
      }
    },
    {
      "id": "tabbar_config",
      "file": "src/data/mobileData.ts",
      "description": "由共享运行时数据提供的底部导航配置",
      "required": false,
      "type": "config",
      "category": "config",
      "example": "export const tabs = [{ label: '首页', path: '/', icon: '⌂' }]",
      "dependencies": null,
      "styleVariables": null,
      "outputFormat": "TypeScript 数组导出"
    },
