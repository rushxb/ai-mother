    {
      "id": "user_store",
      "file": "src/stores/user.ts",
      "description": "用户状态管理，包含登录、token、用户信息",
      "required": true,
      "type": "store",
      "category": "state",
      "example": "export const useUserStore = defineStore('user', () => {\n  const token = ref('')\n  const userInfo = ref<UserInfo | null>(null)\n  \n  async function login(params: LoginParams) { ... }\n  async function logout() { ... }\n  \n  return { token, userInfo, login, logout }\n})",
      "dependencies": [
        "src/types/index.ts"
      ],
      "styleVariables": null,
      "outputFormat": "Pinia store，使用 Composition API",
      "aiHints": {
        "pattern": "Pinia defineStore + ref + computed + async actions",
        "persist": true
      }
    },
    {
      "id": "cart_store",
      "file": "src/stores/cart.ts",
      "description": "购物车状态管理，包含商品、数量、总价",
      "required": false,
      "type": "store",
      "category": "state",
      "example": "export const useCartStore = defineStore('cart', () => {\n  const items = ref<CartItem[]>([])\n  const totalCount = computed(() => items.value.reduce(...))\n  \n  function addItem(product: Product) { ... }\n  function removeItem(productId: number) { ... }\n  \n  return { items, totalCount, addItem, removeItem }\n})",
      "dependencies": [
        "src/data/mock.ts"
      ],
      "styleVariables": null,
      "outputFormat": "Pinia store，使用 Composition API",
      "aiHints": {
        "pattern": "Pinia defineStore + ref + computed + actions",
        "persist": true
      }
    },
    {
