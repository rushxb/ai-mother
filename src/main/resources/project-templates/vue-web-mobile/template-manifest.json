      "category": "ui",
      "example": "<DrawerRoot>\n  <DrawerTrigger>打开抽屉</DrawerTrigger>\n  <DrawerContent>\n    <div>抽屉内容</div>\n  </DrawerContent>\n</DrawerRoot>",
      "dependencies": null,
      "styleVariables": null,
